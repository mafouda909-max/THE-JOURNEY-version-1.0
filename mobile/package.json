{
  "name": "the-journey-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "THE JOURNEY / الرحلة — Expo (React Native) companion app for travelers: browse published offers, read verified agents, send contact requests.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "bundle": "expo export --platform ios --output-dir dist",
    "verify": "npm run typecheck && npm test && npm run bundle"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
