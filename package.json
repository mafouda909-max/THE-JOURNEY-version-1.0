{
  "name": "sila",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --import tsx scripts/prepare-password-pilot.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:check": "tsx scripts/check-production-schema.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:test": "npm --prefix mobile test",
    "mobile:bundle": "npm --prefix mobile run bundle",
    "mobile:verify": "npm --prefix mobile run verify",
    "design:sync": "node scripts/generate-design-tokens.mjs",
    "design:check": "npm run design:sync && git diff --exit-code -- src/styles/sila-generated.css mobile/src/generated-brand-tokens.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:mobile": "npm --prefix mobile audit --omit=dev --audit-level=high",
    "browser:test": "playwright test",
    "service:browser-seed": "node --import tsx scripts/seed-service-browser.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.37.0",
    "next": "16.3.8",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.19.0-preview-headless-dashboard.7",
    "tsx": "^4.23.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
