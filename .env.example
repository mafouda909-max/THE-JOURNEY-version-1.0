# SILA / صلة — deployment environment template (legacy infrastructure names may remain during migration)
# Never commit real credentials. Production values belong in the hosting provider's secret environment.
# Variable names below MUST match what the code reads (src/**). Do not invent alternates.

DATABASE_URL=
NODE_ENV=production

# Public base URL. Current pilot: https://the-journey-version-1-0.vercel.app.
# A paid custom domain is not required; use the same origin for AUTH_ORIGIN.
NEXT_PUBLIC_SITE_URL=
# Legacy alias accepted as fallback by sitemap/robots if NEXT_PUBLIC_SITE_URL is unset.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=   # optional real, monitored support address; leave blank if unavailable
NEXT_PUBLIC_AGENTS_EMAIL=    # optional real, monitored onboarding address; leave blank if unavailable
PUBLIC_INDEXING_ENABLED=false # direct-link public pilot; search indexing remains disabled

# Private Backblaze B2 object storage — S3-compatible API.
# Use a bucket-scoped application key; never use the Backblaze master key.
B2_ENDPOINT=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
# One-time Production preparation; existing keys must permit reading/writing CORS.
# Does not change bucket privacy, grants or Preview storage. Disable after use.
PRIVATE_STORAGE_CORS_PREPARE_ENABLED=false

# Optional integrations — names exactly as read by the code:
RESEND_API_KEY=          # src/lib/providers/email.ts
RESEND_FROM_EMAIL=       # bare sender address on the verified sending domain
RESEND_SENDING_DOMAIN_ID= # exact Resend domain ID; runtime verifies this domain only
RESEND_WEBHOOK_SECRET=   # signed delivery events from Resend
ADMIN_API_KEY=           # src/lib/auth.ts — admin trust-desk boundary (fail-closed 503 when unset)
LINKING_TOKEN_SECRET=    # src/lib/identity-linking.ts — min 16 chars; linking disabled without it

# Optional AI runtime — exact names used by SILA.
# Safe default: zero-cost Pilot. Never paste real keys into source control.
AI_MODEL_FAST=
AI_MODEL_STRONG=
OPENROUTER_API_KEY=
SILA_AI_TIER=pilot
SILA_OPENROUTER_PILOT_MODEL=openrouter/free
SILA_AI_ALLOW_PAID_CALLS=false
SILA_AI_ALLOW_BACKGROUND_CALLS=false
SILA_AI_MONTHLY_BUDGET_USD=
SILA_AI_MONTHLY_BUDGET_EGP=

# Gemini Context Worker — public/redacted long-context analysis only.
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=  # accepted alias; prefer one Gemini key variable, not both
SILA_GEMINI_CONTEXT_ENABLED=false
SILA_GEMINI_CONTEXT_MODEL=gemini-3.8-flash
SILA_GEMINI_CONTEXT_MAX_CHARS=250000

# Guarded paid providers. Leave empty/off during zero-cost Pilot.
OPENAI_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
# Legacy/alternate Gateway credentials accepted by runtime:
# VERCEL_AI_GATEWAY_KEY=
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is supplied by Vercel when available; do not commit it.
SILA_VERCEL_GATEWAY_ENABLED=false

TAVILY_API_KEY=
SILA_WEB_SEARCH_MODEL=
SILA_GATEWAY_FAST_MODEL=
SILA_GATEWAY_STRONG_MODEL=


# Integrated from travel candidate
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
AMADEUS_BASE_URL=
# Enable only after live supplier credentials + search validation in that environment.
FLIGHT_COMPARE_ENABLED=false


# Integrated from community candidate
COMMUNITY_ENABLED=false
NEXT_PUBLIC_COMMUNITY_ENABLED=false

# Traveler Personal Workspace: enable only after Phase 6 migration in that environment
TRAVELER_WORKSPACE_ENABLED=false

# Passwordless authentication (recommended)
# Exact origin for OAuth callbacks and magic-link URLs; configure separately per environment.
# Google can be activated independently of Resend; verified sending gates magic links only.
AUTH_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=false
MAGIC_LINK_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_MAGIC_LINK_ENABLED=false
GOOGLE_ADMIN_EMAIL_ALLOWLIST=  # comma-separated pre-existing admin emails only; never creates admins

# First-party password pilot — no OAuth client or email sender required.
PASSWORD_AUTH_ENABLED=false
NEXT_PUBLIC_PASSWORD_AUTH_ENABLED=false
# Generate a random 32-byte hex secret; store as sensitive in the hosting environment.
PASSWORD_AUTH_RATE_LIMIT_SECRET=
# Production build only: applies db/password_pilot_auth.sql using direct managed DB TLS.
PASSWORD_PILOT_PREPARE_ENABLED=false

# Legacy password migration switches — keep false by default.
LEGACY_PASSWORD_LOGIN_ENABLED=false
LEGACY_ADMIN_PASSWORD_LOGIN_ENABLED=false
NEXT_PUBLIC_LEGACY_PASSWORD_LOGIN_ENABLED=false
# Service fulfillment pilot: comma-separated office workspace IDs; empty = off.
# Apply db/service_fulfillment_pilot.sql and confirm the trial's terms first.
SERVICE_FULFILLMENT_PILOT_WORKSPACE_IDS=

# Vercel previews must use a distinct, branch-scoped database URL.
# DATABASE_URL remains the inherited production reference for the isolation check.
SILA_PREVIEW_DATABASE_URL=
