# THE JOURNEY — Environment contract (Slice 0)
# Copy to .env.local and fill from your Supabase project: Settings → API.
# Provisioning status: BLOCKED until real Supabase project exists (see report).

# ── Public — safe for browser bundles ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin (sitemap.ts / robots.ts / future canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only — NEVER exposed to the client (AD-06 / AD-14) ───────
# Enforced mechanically via `import "server-only"` in src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini API (Sila Smart Advisor) ─────────────────────────
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: override model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── OpenRouter (LLM streaming chat) ────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the default model (defaults to google/gemini-3.7-flash)
# OPENROUTER_MODEL=google/gemini-3.7-flash

# ── Ox Alpha API (Tokenra) ──────────────────────────────────────────
TOKENRA_API_KEY=

# ── Gated demo seeding (AD-12) ───────────────────────────────────────
# MUST remain unset/absent in production. Demo seed scripts refuse to run without it.
# DEMO_SEED_ENABLED=true

# ── Staging/local demo preview (AD-17 deviation #8) ─────────────────
# NON-PRODUCTION BUILDS ONLY. When true (and only outside production builds —
# hard guard in src/lib/data), discovery surfaces read the staging-only
# `public_offers_staging` / `public_agent_profiles_staging` projections,
# which expose ONLY is_demo = true rows. Production builds always read the
# canonical views regardless of this value. The staging views themselves are
# provisioned exclusively on the staging project via db/staging/0010.
# NEXT_PUBLIC_DEMO_PREVIEW=true
