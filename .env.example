# THE JOURNEY — Environment contract (Slice 0)
# Copy to .env.local and fill from your Supabase project: Settings → API.
# Provisioning status: BLOCKED until real Supabase project exists (see report).

# ── Public — safe for browser bundles ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only — NEVER exposed to the client (AD-06 / AD-14) ───────
# Enforced mechanically via `import "server-only"` in src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# ── Gated demo seeding (AD-12) ───────────────────────────────────────
# MUST remain unset/absent in production. Demo seed scripts refuse to run without it.
# DEMO_SEED_ENABLED=true
