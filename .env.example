# SILA / صلة — deployment environment template (legacy infrastructure names may remain during migration)
# Never commit real credentials. Production values belong in the hosting provider's secret environment.
# Variable names below MUST match what the code reads (src/**). Do not invent alternates.

DATABASE_URL=
NODE_ENV=production

# Public base URL of the deployed site (used by /sitemap.xml and /robots.txt).
NEXT_PUBLIC_SITE_URL=
# Legacy alias accepted as fallback by sitemap/robots if NEXT_PUBLIC_SITE_URL is unset.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=   # public support address; keep legacy address until new domain is verified
NEXT_PUBLIC_AGENTS_EMAIL=    # public agency onboarding address; keep legacy address until new domain is verified

# Private Backblaze B2 object storage — S3-compatible API.
# Use a bucket-scoped application key; never use the Backblaze master key.
B2_ENDPOINT=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional integrations — names exactly as read by the code:
RESEND_API_KEY=          # src/lib/providers/email.ts
RESEND_WEBHOOK_SECRET=   # signed delivery events from Resend
ADMIN_API_KEY=           # src/lib/auth.ts — admin trust-desk boundary (fail-closed 503 when unset)
LINKING_TOKEN_SECRET=    # src/lib/identity-linking.ts — min 16 chars; linking disabled without it

# Optional AI model routing (src/lib/config.ts, src/lib/providers/ai.ts)
AI_MODEL_FAST=
AI_MODEL_STRONG=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=


# Integrated from travel candidate
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
AMADEUS_BASE_URL=
# Enable only after live supplier credentials + search validation in that environment.
FLIGHT_COMPARE_ENABLED=false


# Integrated from community candidate
COMMUNITY_ENABLED=false
NEXT_PUBLIC_COMMUNITY_ENABLED=false

# Traveler Personal Workspace: enable only after Phase 6 migration in that environment
TRAVELER_WORKSPACE_ENABLED=false

# Passwordless authentication (recommended)
# Exact origin for OAuth callbacks and magic-link URLs; configure separately per environment.
AUTH_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=false
MAGIC_LINK_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_MAGIC_LINK_ENABLED=false
GOOGLE_ADMIN_EMAIL_ALLOWLIST=  # comma-separated pre-existing admin emails only; never creates admins

# Legacy password migration switches — keep false by default.
LEGACY_PASSWORD_LOGIN_ENABLED=false
LEGACY_ADMIN_PASSWORD_LOGIN_ENABLED=false
NEXT_PUBLIC_LEGACY_PASSWORD_LOGIN_ENABLED=false
# Service fulfillment pilot: comma-separated office workspace IDs; empty = off.
# Apply db/service_fulfillment_pilot.sql and confirm the trial's terms first.
SERVICE_FULFILLMENT_PILOT_WORKSPACE_IDS=
